{
  "name": "agentshield-mcp-inspector",
  "version": "0.1.0",
  "description": "Local-first MCP security inspector that discovers tools, analyzes schemas, flags risky capabilities, and exports Markdown/JSON reports.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "agentshield": "src/cli.js",
    "agentshield-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "scan:sample": "node src/cli.js scan-json examples/sample-tools.json",
    "test": "node --test"
  },
  "keywords": ["mcp", "model-context-protocol", "security", "scanner", "agent", "ai", "tooling"],
  "author": "Mahmoud Hisham",
  "license": "SEE LICENSE.txt",
  "engines": {"node": ">=20"},
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.1.0"
  }
}
